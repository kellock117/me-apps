# 복사해서 .env.local로 쓴다. 이 파일에는 실제 값을 넣지 않는다.
# NEXT_PUBLIC_ 접두사는 어떤 변수에도 붙이지 않는다 (키는 서버에만 둔다).

# Supabase (서버 전용)
SUPABASE_URL=
# sb_secret_… 형식 (대시보드 Settings → API Keys). 예전 service_role 키는 2026년 말 폐기 예정
SUPABASE_SECRET_KEY=

# 사이트 잠금
SITE_PASSWORD=
ADMIN_PASSWORD=

# 책 검색
# 카카오 REST API 키 (책 검색: 제목·저자·표지)
KAKAO_REST_API_KEY=
# 국립중앙도서관 ISBN 서지정보 인증키 (쪽수 보강). 없으면 쪽수만 비어 있다
LIBRARY_API_KEY=

# 크론 호출 검증 (Vercel Cron)
CRON_SECRET=

# 웹 푸시(VAPID). 키 만들기: npx web-push generate-vapid-keys
# 공개 키는 서버가 읽어 화면에 넘긴다(NEXT_PUBLIC_ 아님). 비밀 키는 서버에만 둔다. 셋 중 하나라도 없으면 알림 켜기 줄이 안 나온다
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스가 문제 있을 때 연락할 주소: mailto:… 또는 https://… (개인 이메일은 레포에 쓰지 않는다)
VAPID_SUBJECT=

# 노션 이전 스크립트에서만 사용. 이전이 끝나면 통합을 삭제한다
NOTION_TOKEN=
